{
  "color": {
    "bg": { "$value": "#000000", "$type": "color" },
    "surface": { "$value": "#0a0a0a", "$type": "color" },
    "fg": { "$value": "#ededed", "$type": "color" },
    "fg-muted": { "$value": "#a1a1a1", "$type": "color" },
    "border": { "$value": "#1f1f1f", "$type": "color" },
    "border-strong": { "$value": "#6e6e6e", "$type": "color" },
    "hover": { "$value": "#1a1a1a", "$type": "color" },
    "ring": { "$value": "#ededed", "$type": "color" },
    "accent": { "$value": "#ededed", "$type": "color" },
    "accent-fg": { "$value": "#0a0a0a", "$type": "color" },
    "accent-hover": { "$value": "color-mix(in oklab, {color.accent} 88%, {color.bg})", "$type": "color" },
    "danger": { "$value": "#ff6369", "$type": "color" },
    "danger-fg": { "$value": "#000000", "$type": "color" },
    "danger-hover": { "$value": "color-mix(in oklab, {color.danger} 88%, {color.bg})", "$type": "color" }
  }
}
