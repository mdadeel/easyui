{
  "radius": {
    "none": { "$value": "0px", "$type": "dimension" },
    "sm": { "$value": "0.375rem", "$type": "dimension" },
    "md": { "$value": "0.5rem", "$type": "dimension" },
    "lg": { "$value": "0.75rem", "$type": "dimension" },
    "full": { "$value": "9999px", "$type": "dimension" },
    "base": { "$value": "{radius.md}", "$type": "dimension" }
  },
  "font": {
    "sans": {
      "$value": "\"Geist Variable\", \"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
      "$type": "fontFamily"
    },
    "mono": {
      "$value": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace",
      "$type": "fontFamily"
    }
  },
  "border": {
    "width": { "$value": "1px", "$type": "dimension" }
  },
  "duration": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "base": { "$value": "200ms", "$type": "duration" }
  },
  "easing": {
    "out": { "$value": "cubic-bezier(0.2, 0, 0, 1)", "$type": "cubicBezier" }
  }
}
